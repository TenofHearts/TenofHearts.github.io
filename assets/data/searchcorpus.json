---
layout: null
---
[
{% assign separator = '' %}
{% for post in site.posts %}
  {% assign title = post.title | default: post.excerpt | strip_html | strip | escape %}
  {{ separator }}{
    "title": {{ title | jsonify }},
    "desc": {{ title | jsonify }},
    "category": {{ post.tags | join: ', ' | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | escape | jsonify }},
    "date": {{ post.date | date: '%B %e, %Y' | default: 'January 1, 1970' | jsonify }}
  }
  {% assign separator = ',' %}
{% endfor %}
{% for page in site.html_pages %}
  {% if page.search == false or page.title == '{title}' or page.title == '404 - Page not found' %}{% continue %}{% endif %}
  {% assign title = page.title | default: page.excerpt | strip_html | strip | escape %}
  {{ separator }}{
    "title": {{ title | jsonify }},
    "desc": {{ title | jsonify }},
    "category": {% if page.tags %}{{ page.tags | join: ', ' | jsonify }}{% else %}"page"{% endif %},
    "url": {{ page.url | prepend: site.baseurl | jsonify }},
    "date": {{ page.date | date: '%B %e, %Y' | default: 'January 1, 1970' | jsonify }}
  }
  {% assign separator = ',' %}
{% endfor %}
]
